# Copy to .env.local and fill in what you need. Every variable is optional:
# without them FretLearn runs fully in the browser and keeps settings in localStorage.

# Supabase: accounts, cloud sync and practice history (see supabase/migrations/)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Leave unset to ship with no analytics
# (the cookie banner is hidden too).
VITE_GTM_ID=
